;; -*- lexical-binding: t; -*-

(deftheme my-pastels
  "Created 2025-11-12.")

(custom-theme-set-faces
 'my-pastels
 '(cursor ((t (:background "yellow"))))
 '(fixed-pitch ((t (:family "Monospace"))))
 '(variable-pitch ((((type w32)) (:foundry "outline" :family "Arial")) (t (:family "Sans Serif"))))
 '(escape-glyph ((t (:foreground "#c4a000"))))
 '(homoglyph ((t (:foreground "#c4a000"))))
 '(minibuffer-prompt ((t (:height 90 :foreground "#b4fa70"))))
 '(highlight ((t (:background "azure" :foreground "gray0"))))
 '(region ((t (:extend t :background "#944a05"))))
 '(shadow ((t (:foreground "green1"))))
 '(secondary-selection ((t (:extend t :background "#2A5FB0"))))
 '(trailing-whitespace ((t (:background "#a40000"))))
 '(font-lock-bracket-face ((t (:inherit (font-lock-punctuation-face)))))
 '(font-lock-builtin-face ((t (:foreground "yellow"))))
 '(font-lock-comment-delimiter-face ((t (:inherit (font-lock-comment-face)))))
 '(font-lock-comment-face ((t (:foreground "#A9FA5F"))))
 '(font-lock-constant-face ((t (:foreground "chocolate"))))
 '(font-lock-delimiter-face ((t (:inherit (font-lock-punctuation-face)))))
 '(font-lock-doc-face ((t (:inherit shell-highlight-undef-alias-face))))
 '(font-lock-doc-markup-face ((t (:inherit (font-lock-constant-face)))))
 '(font-lock-escape-face ((t (:inherit (font-lock-regexp-grouping-backslash)))))
 '(font-lock-function-call-face ((t (:inherit font-lock-function-name-face :foreground "gold" :slant italic))))
 '(font-lock-function-name-face ((t (:foreground "orange"))))
 '(font-lock-keyword-face ((t (:foreground "spring green"))))
 '(font-lock-negation-char-face ((t (:foreground "orange red"))))
 '(font-lock-number-face ((t (:foreground "turquoise2"))))
 '(font-lock-misc-punctuation-face ((t (:inherit (font-lock-punctuation-face)))))
 '(font-lock-operator-face ((t (:box (:line-width (1 . 1) :color "grey75" :style flat-button)))))
 '(font-lock-preprocessor-face ((t (:inherit font-lock-builtin-face))))
 '(font-lock-property-name-face ((t (:foreground "deep pink" :inherit font-lock-variable-name-face))))
 '(font-lock-punctuation-face ((t nil)))
 '(font-lock-regexp-grouping-backslash ((t (:inherit (bold)))))
 '(font-lock-regexp-grouping-construct ((t (:inherit (bold)))))
 '(font-lock-string-face ((t (:foreground "LightPink2"))))
 '(font-lock-type-face ((t (:foreground "deep sky blue"))))
 '(font-lock-variable-name-face ((t (:foreground "hot pink"))))
 '(font-lock-variable-use-face ((t (:inherit font-lock-variable-name-face :foreground "wheat" :slant italic))))
 '(font-lock-warning-face ((t (:inherit error))))
 '(button ((t (:inherit (link)))))
 '(link ((t (:underline (:color foreground-color :style line :position nil) :foreground "#729fcf"))))
 '(link-visited ((t (:foreground "magenta4" :underline t))))
 '(fringe ((t (:background "#212526"))))
 '(header-line ((t (:box nil :foreground "grey90" :background "grey20" :inherit (mode-line)))))
 '(tooltip ((t (:foreground "black" :background "lightyellow" :inherit (variable-pitch)))))
 '(mode-line ((t (:height 100 :box (:line-width (1 . -1) :color nil :style released-button) :foreground "#2e3436" :background "#d3d7cf"))))
 '(mode-line-buffer-id ((t (:weight bold))))
 '(mode-line-emphasis ((t (:weight bold))))
 '(mode-line-highlight ((t (:box (:line-width (2 . 2) :color "grey40" :style released-button)))))
 '(mode-line-inactive ((t (:height 100 :box (:line-width (1 . -1) :color nil :style released-button) :foreground "#eeeeec" :background "#555753"))))
 '(isearch ((t (:foreground "#eeeeec" :background "#ce5c00"))))
 '(isearch-fail ((((class color) (min-colors 88) (background light)) (:background "RosyBrown1")) (((class color) (min-colors 88) (background dark)) (:background "red4")) (((class color) (min-colors 16)) (:background "red")) (((class color) (min-colors 8)) (:background "red")) (((class color grayscale)) (:foreground "grey")) (t (:inverse-video t))))
 '(lazy-highlight ((t (:background "#8f5902"))))
 '(match ((((class color) (min-colors 88) (background light)) (:background "khaki1")) (((class color) (min-colors 88) (background dark)) (:background "RoyalBlue3")) (((class color) (min-colors 8) (background light)) (:foreground "black" :background "yellow")) (((class color) (min-colors 8) (background dark)) (:foreground "white" :background "blue")) (((type tty) (class mono)) (:inverse-video t)) (t (:background "gray"))))
 '(next-error ((t (:inherit (region)))))
 '(query-replace ((t (:inherit (isearch)))))
 '(error ((t (:foreground "firebrick2"))))
 '(custom-button-unraised ((t (:inherit (underline mode-line)))))
 '(org-headline-done ((t (:foreground "SpringGreen1"))))
 '(org-headline-todo ((t (:foreground "red2"))))
 '(org-level-2 ((t (:inherit outline-2 :extend nil))))
 '(outline-2 ((t (:inherit font-lock-variable-name-face))))
 '(org-block ((t (:inherit shadow :extend t))))
 '(markdown-list-face ((t (:inherit markdown-markup-face))))
 '(markdown-markup-face ((t (:inherit markdown-inline-code-face :slant normal :weight normal))))
 '(fountain-section-heading-1 ((t (:inherit outline-1 :foreground "deep sky blue" :weight heavy))))
 '(fountain-section-heading-2 ((t (:inherit outline-2 :weight bold))))
 '(hl-line ((t (:inherit nil :underline (:color "green1" :style dots :position -4)))))
 '(org-code ((t (:background "gray" :foreground "yellow"))))
 '(org-verbatim ((t (:background "gray" :foreground "#00F5D4"))))
 '(lsp-face-highlight-read ((t (:underline (:color foreground-color :style line :position nil) :inherit (highlight)))))
 '(line-number ((t (:inherit (shadow default) :foreground "light blue"))))
 '(line-number-current-line ((t (:inherit line-number :foreground "red"))))
 '(linum ((t (:inherit (line-number) :foreground "orange"))))
 '(default ((t (:inherit nil :extend nil :stipple nil :background "#303030" :foreground "white" :inverse-video nil :box nil :strike-through nil :overline nil :underline nil :slant normal :weight regular :height 98 :width normal :foundry "PfEd" :family "DejaVu Sans Mono")))))

;;; To reload - Evaluate the above and call `load-theme RET my-pastels RET`
(provide-theme 'my-pastels)
