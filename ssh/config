Host oscar.github.com
    HostName github.com
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent yes

Host tom.github.com
    HostName github.com
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/github.key

Host *
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    StrictHostKeyChecking no
