[global]
	# Geometry
	width = 300
	height = (0, 300)
	offset = (30, 20)
	origin = top-right

	follow = mouse

	# Default Formatting
	font = Monospace 10
	format = "<b>%s</b>\n%b"
	icon_position = left
	max_icon_size = 32
	min_icon_size = 0
	background = "#282A36"
	foreground = "#F8F8F2"
	frame_color = "#44475A"

	# History
	# history = ctrl+grave

[urgency_low]
	background = "#222222"
	foreground = "#888888"
	timeout = 10

[urgency_normal]
	background = "#285577"
	foreground = "#ffffff"
	frame_color = "#ffffff"
	timeout = 10

[urgency_critical]
	background = "#900000"
	foreground = "#ffffff"
	frame_color = "#ff0000"
	timeout = 0

# Use as: notify-send -a failure <subject> [message]
[failure_rule]
	appname = "failure"
	frame_color = "#900000"
	background = "#900000"
	foreground = "#ffffff"

# Use as: notify-send -a success <subject> [message]
[success_rule]
	appname = "success"
	frame_color = "#98c379"
	background = "#98c379"
	foreground = "#000000"